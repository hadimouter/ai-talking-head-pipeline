# Hedra API key. Get one at https://www.hedra.com/develop/api-keys
# (requires a paid Hedra plan; generation is billed per second of video)
HEDRA_API_KEY=your-api-key-here

# Optional overrides for generate-hedra-video.sh (see the script for defaults)
# HEDRA_MODEL=hedra-character-3
# HEDRA_ASPECT_RATIO=3:4
# HEDRA_RESOLUTION=720p
# HEDRA_PROMPT=A person speaking naturally and directly to the camera, calm expression, talking-head podcast style, subtle head movement.

# Optional: only needed if you don't want to record your own voice.
# HeyGen API key for generate-speech.sh (pay-as-you-go, no free tier).
# Get one at https://app.heygen.com/settings?nav=API
# HEYGEN_API_KEY=your-api-key-here
# HEYGEN_VOICE_ID=a-starfish-compatible-voice-id
# HEYGEN_SPEECH_SPEED=1
# HEYGEN_LANGUAGE=
